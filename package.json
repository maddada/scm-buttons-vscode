						"description": "%configuration.gitSync%",
						"order": 6
					},
					"git-buttons.showGitSyncRebase": {
						"type": "boolean",
						"default": false,
						"description": "%configuration.gitSyncRebase%",
						"order": 7
					},
					"git-buttons.showGitCheckout": {
						"type": "boolean",
						"default": false,
						"description": "%configuration.gitCheckout%",
						"order": 8
					},
					"git-buttons.showGitPublish": {
