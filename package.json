		"menus": {
			"scm/title": [
				{
					"when": "scmProvider == git && config.git-buttons.showGitPull && config.git-buttons.commandsLocation == 'Inline'",
					"command": "git.pull",
					"group": "navigation@1"
				},
				{
					"when": "scmProvider == git && config.git-buttons.showGitPullRebase && config.git-buttons.commandsLocation == 'Inline'",
					"command": "git.pullRebase",
					"group": "navigation@2"
				},
				{
					"when": "scmProvider == git && config.git-buttons.showGitPullFrom && config.git-buttons.commandsLocation == 'Inline'",
					"command": "git.pullFrom",
					"group": "navigation@3"
				},
				{
					"when": "scmProvider == git && config.git-buttons.showGitPush && config.git-buttons.commandsLocation == 'Inline'",
					"command": "git.push",
					"group": "navigation@4"
				},
				{
					"when": "scmProvider == git && config.git-buttons.showGitPushTo && config.git-buttons.commandsLocation == 'Inline'",
					"command": "git.pushTo",
					"group": "navigation@5"
				},
				{
					"when": "scmProvider == git && config.git-buttons.showGitSync && config.git-buttons.commandsLocation == 'Inline'",
					"command": "git.sync",
					"group": "navigation@6"
				},
				{
					"when": "scmProvider == git && config.git-buttons.showGitSyncRebase && config.git-buttons.commandsLocation == 'Inline'",
					"command": "git.syncRebase",
					"group": "navigation@7"
				},
				{
					"when": "scmProvider == git && config.git-buttons.showGitCheckout && config.git-buttons.commandsLocation == 'Inline'",
					"command": "git.checkout",
					"group": "navigation@8"
				},
				{
					"when": "scmProvider == git && config.git-buttons.showGitPublish && config.git-buttons.commandsLocation == 'Inline'",
					"command": "git.publish",
					"group": "navigation@9"
				},
				{
					"when": "scmProvider == git && config.git-buttons.showGitCommitAll && config.git-buttons.commandsLocation == 'Inline'",
					"command": "git.commitAll",
					"group": "navigation@10"
				},
				{
					"when": "scmProvider == git && config.git-buttons.showGitCommitAllAmend && config.git-buttons.commandsLocation == 'Inline'",
					"command": "git.commitAllAmend",
					"group": "navigation@11"
				},
				{
					"when": "scmProvider == git && config.git-buttons.showGitCommitAllSigned && config.git-buttons.commandsLocation == 'Inline'",
					"command": "git.commitAllSigned",
					"group": "navigation@12"
				},
				{
					"when": "scmProvider == git && config.git-buttons.showGitCommitStaged && config.git-buttons.commandsLocation == 'Inline'",
					"command": "git.commitStaged",
					"group": "navigation@13"
				},
				{
					"when": "scmProvider == git && config.git-buttons.showGitCommitStagedAmend && config.git-buttons.commandsLocation == 'Inline'",
					"command": "git.commitStagedAmend",
					"group": "navigation@14"
				},
				{
					"when": "scmProvider == git && config.git-buttons.showGitCommitStagedSigned && config.git-buttons.commandsLocation == 'Inline'",
					"command": "git.commitStagedSigned",
					"group": "navigation@15"
				},
				{
					"when": "scmProvider == git && config.git-buttons.showGitUndoCommit && config.git-buttons.commandsLocation == 'Inline'",
					"command": "git.undoCommit",
					"group": "navigation@16"
