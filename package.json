	"icon": "resources/icon.png",
	"main": "extension/extension.js",
	"contributes": {
		"configuration": [
			{
				"id": "git-buttons-common",
				"title": "Сommon",
				"properties": {
					"git-buttons.commandsLocation": {
						"type": "string",
						"enum": [
							"Inline",
							"More Actions"
						],
						"enumDescriptions": [
							"%configuration.commandsLocation.inline.description%",
							"%configuration.commandsLocation.moreActions.description%"
						],
						"default": "Inline",
						"description": "%configuration.commandsLocation.description%"
					}
				}
			},
			{
				"id": "git-buttons-commands",
				"title": "Сommands",
				"properties": {
					"git-buttons.showGitPull": {
						"type": "boolean",
						"default": true,
						"description": "%configuration.gitPull%",
						"order": 1
					},
					"git-buttons.showGitPullRebase": {
						"type": "boolean",
						"default": false,
						"description": "%configuration.gitPullRebase%",
						"order": 2
					},
